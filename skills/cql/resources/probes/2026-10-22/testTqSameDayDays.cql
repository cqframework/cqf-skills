library testTqSameDayDays version '1.0.0'

define "DaysSameDay": days between @2026-01-01T15:00:00Z and @2026-01-01T19:00:00Z
define "DaysNextDay": days between @2026-01-01T15:00:00Z and @2026-01-02T19:00:00Z
define "DifferenceDaysSameDay": difference in days between @2026-01-01T15:00:00Z and @2026-01-01T19:00:00Z
