library testDtUnits

define "MonthEq30Days": 1 month = 30 days
define "MonthEquiv30Days": 1 month ~ 30 days
define "YearEq12Months": 1 year = 12 months
define "DayEq24Hours": 1 day = 24 hours
define "UcumMonthEqMonth": 1 'mo' = 1 month
define "UcumMonthEquivMonth": 1 'mo' ~ 1 month
define "UcumDayEqDay": 1 'd' = 1 day
define "DaysGtNumber": 5 days > 3
