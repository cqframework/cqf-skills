# Python and test caches
__pycache__/
*.pyc
.pytest_cache/

# OS and editor files
.DS_Store
*.swp

# cql: the CQL spec copy is built locally by skills/cql/scripts/fetch-spec.sh.
# HL7 spec text is not redistributed in this repository.
skills/cql/resources/spec/*
!skills/cql/resources/spec/README.md

# crmi, cpg, fhir-extensions: the profile KB is built locally by each skill's
# scripts/build-kb.sh from pinned FHIR packages.
skills/crmi/resources/profiles/
skills/cpg/resources/profiles/
skills/fhir-extensions/resources/profiles/
skills/cql-ig/resources/profiles/
skills/uscore/resources/profiles/
skills/usqualitycore/resources/profiles/

# ig-publisher: local copies of the tools IG, templates, publisher docs and sample IG are
# built by skills/ig-publisher/scripts/fetch-sources.sh from pinned locators.
skills/ig-publisher/resources/sources/*
!skills/ig-publisher/resources/sources/README.md
